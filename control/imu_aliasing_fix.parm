# IMU vibration-aliasing fix — Pixhawk 6C (ArduCopter 4.6.3)
# Background: instructions/vpe_jump_runaway_diagnosis.md §14-3/14-4.
# RAW_IMU streams the FILTERED loop-rate values (source-verified: notch+LPF
# for gyro, LPF for accel), but prop harmonics >100 Hz still leak past the
# 20 Hz LPF and the 400→200 Hz stream decimation folds them into 0-100 Hz.
#
# ADDITIVE to real_hw_pixhawk6c.parm (or to FC defaults). Load with:
#   python3 control/load_fc_params.py --file control/imu_aliasing_fix.parm \
#       --reboot   # (device default /dev/ttyUSB0; reboot needed for BAT_MASK)
# NOTE: FC is currently at as-arrived defaults (main param set was reverted
# 2026-07-21 on request) — loading this file alone is safe; it only touches
# logging/filtering, nothing flight-behavioral except the notch when enabled.

# ── STAGE 1: see the true >100 Hz spectrum (bench prop-spin session) ──────
# Batch logging writes ~kHz IMU samples (ISBH/ISBD) to the dataflash log.
# Starts when armed; spin props tied-down/hover ~60 s across the throttle
# range, then pull the .bin and FFT it (or use MAVExplorer's FFT graph).
# REBOOT REQUIRED after setting BAT_MASK.
INS_LOG_BAT_MASK 1
# bit0 = sensor-rate sampling (full rate the FC sees, highest Nyquist)
# bit2 = log pre- AND post-filter (shows exactly what the notch/LPF remove)
# If the SD card can't keep up (gaps in ISBD), drop to 4 (pre+post at 1 kHz)
# or 0 (post-filter only).
INS_LOG_BAT_OPT 5

# ── STAGE 2: harmonic notch — FILLED from survey24 flight-1 batch log ────
# Gyro-only (ArduPilot applies no notch to accel; accel relies on
# INS_ACCEL_FILTER + the 400 Hz streaming + physical mounting).
# 2026-07-23: field_data/survey24/vibe_analysis/batch_fft.py decoded the
# ISBH/ISBD batch log (~2022.5 Hz sensor rate, no stream aliasing) for the
# hover segment (t=15-95s, Alt~0.9-1.0m steady, ThO~0.218-0.222, matches
# REF below). Clean single narrowband gyro line, power-weighted centroid
# 134.3 Hz (individual bins 126-142 Hz, peak bin 136.3 Hz); confirmed by a
# 2nd-harmonic accel line at ~260-266 Hz (~2x). Climb segment (100-150s,
# throttle up to ~0.24) shifted the same line to ~138-142 Hz, consistent
# with throttle-tracked blade-pass — supports MODE 1 (throttle-based).
INS_HNTCH_ENABLE 1
INS_HNTCH_MODE 1          # 1 = throttle-based tracking
INS_HNTCH_REF 0.22         # = learned MOT_THST_HOVER (confirmed via CTUN ThO at hover)
INS_HNTCH_FREQ 134        # blade-pass fundamental, power-weighted centroid @ hover
INS_HNTCH_BW 67            # FREQ/2
INS_HNTCH_HMNCS 3         # 1st + 2nd harmonics (2nd harmonic visible on accel ~2x)
# Alternative if ESCs give no reliable throttle reference: in-flight FFT mode
#FFT_ENABLE 1
#INS_HNTCH_MODE 4

# ── Optional: one octave more accel attenuation (affects FC EKF too —
# adds phase lag; try only if 400 Hz streaming + notch aren't enough) ──────
#INS_ACCEL_FILTER 10
