<?xml version="1.0" encoding="UTF-8"?>
<!--
  FastDDS profile: shared-memory transport with a segment large enough for
  full camera frames (see ros2_env.sh for why + measurements). UDP kept as
  fallback so cross-host DDS would still work if ever needed.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_64mb</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_fallback</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_64mb</transport_id>
        <transport_id>udp_fallback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
