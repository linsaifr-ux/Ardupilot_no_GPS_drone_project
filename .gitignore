# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Simulator caches (large binary/tile data — re-downloadable)
simulator/cesium_tile_cache/
simulator/cesium_terrain_cache/
simulator/cesium_tile_list.json
simulator/cesium_terrain_list.json
simulator/elevation_cache.json
simulator/osm_cache.json
simulator/satellite_ground.jpg

# Isaac Sim generated files
simulator/geo_metadata.json
simulator/*.log
simulator/__pycache__/

# Drone camera live output (transient — overwritten every 5 sim steps)
simulator/drone_frames/

# Flight trace CSVs and plots (runtime output — generated per flight)
simulator/flight_traces/

# AnyLoc generated databases (rebuild with: python anyloc/build_database.py [--model vits14])
anyloc/database
anyloc/database/
anyloc/database_*
anyloc/database_*/

# AnyLoc test / debug output
anyloc/test_output/

# Claude Code local settings
**/.claude/

# Model weights (large files — store in DVC or separate release)
**/*.pt
**/*.pth
**/*.onnx
**/*.weights
**/*.engine

# Dataset files
**/*.bag
**/dataset/
**/data/

# ArduPilot SITL runtime artefacts (written to project root by sim_vehicle.py)
eeprom.bin
mav.tlog
mav.tlog.raw
*.tlog
*.tlog.raw
*.bin
*.parm
!control/no_gps.parm
!control/real_hw.parm
!control/real_hw_pixhawk6c.parm
!control/imu_aliasing_fix.parm
terrain/

# AnyLoc runtime output (written at runtime)
anyloc/latest_estimate.json
anyloc/latest_estimate.json.tmp
anyloc/latest_match.jpg
anyloc/latest_match.jpg.tmp

# Survey detection log and crops (written by px4_commander.py at runtime)
detections.csv
det_crops/

# Terrain elevation written by cesium_scene.py on startup (runtime, machine-specific)
# Keep home_elevation.json tracked — it's manually set to the contest site coordinates
# control/home_elevation.json

# ArduPilot SITL logs (written to project root and control/ by sim_vehicle.py)
logs/
control/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets / credentials
*.env
.env*
*token*
*secret*
*credential*

# Third-party dependencies (cloned separately, not tracked)
# No trailing slash — also matches the symlink at repo root
third_party

#contest ref
114rule.pdf

# Kalibr AprilGrid target — keep the local copy, don't commit the binary;
# source URL recorded in instructions/vpe_jump_runaway_diagnosis.md §13-A
instructions/april_6x6_80x80cm_A0.pdf

# LaTeX build artefacts
instructions/report/*.aux
instructions/report/*.log
instructions/report/*.out
instructions/report/*.toc

# ArduPilot crash dumps (written to project root by SITL)
dumpcore.sh_*.out
dumpstack.sh_*.out

# YOLO training runs (weights, plots, metrics — large and reproducible)
detection/runs/
runs/

# Stray files accidentally created by redirecting to a module name
# (e.g. `python … > np`); these are junk, not source — delete if present.
detection/matplotlib
detection/np
detection/torch

# PX4 SITL runtime artefacts (PX4 itself lives in ~/PX4-Autopilot, but logs/
# params may land here if run from the project tree)
*.ulg
parameters*.bson
rootfs/

# Field data — video, extracted frames, telemetry, and metadata (large/generated on-drone)
# Keep .waypoints mission files only; exclude everything else
field_data/**/imu.csv
field_data/**/attitude.csv
field_data/**/imu_rates.json
field_data/**/video.mkv
field_data/**/frames/
field_data/**/frames.csv
field_data/**/telemetry.csv
field_data/**/meta.json
field_data/**/frame_times.csv

# OpenVINS offline eval (field_data/**/vio_eval/): trajectory CSVs and run
# logs are derived from the raw recording (which is not in git) — keep
# README/plots/configs/scripts tracked, ignore the bulky derived dumps
field_data/**/vio_eval/vio_full*.csv
field_data/**/vio_eval/vio_cruise*.csv
field_data/**/vio_eval/run_*.log

# Kalibr calibration sessions (field_data/calib_*): raw recording files are
# covered by the field_data patterns above; keep the small precious outputs
# (kalibr_output yamls + results txts, KALIBR_PC_README.md,
# prepare_kalibr_input.py) tracked, ignore the bulky report PDFs and the
# PC-side intermediate input trees / bags
field_data/**/kalibr_output/*.pdf
field_data/**/kalibr_input*/

# Streaming directory — ignore only the MediaMTX binary (large, download separately)
# Source files, docs, and config in streaming/ are tracked normally
streaming/mediamtx
streaming/*.log
# Local copies of the ground-view stream (tools/ground_view_stream.py)
recordings/

# MAVLink relay mTLS certs/keys (streaming/generate_relay_certs.sh output) — secrets,
# never commit; each machine (Jetson/Frank's PC/MP machine) gets its own copy by hand
streaming/relay_certs/

# SITL closed-loop test outputs (control/test_full_pipeline_sitl*.py): postview frame
# dumps and assembled videos are large and fully reproducible by rerunning the harness —
# keep the harness scripts and the small summary plot/JSON logs tracked, ignore the bulky
# per-run artifacts. prefix_bug_archive/ is a scratch archive of superseded buggy runs,
# never meant to be preserved in git.
field_data/**/vio_eval/sitl/postview/
field_data/**/vio_eval/sitl/postview_*.mp4
field_data/**/vio_eval/sitl/prefix_bug_archive/

# Offline postview video (field_data/**/vio_eval/postview_offline*.mp4, not under sitl/) --
# same bulky-and-reproducible-by-rerunning-the-postview-script logic as the sitl/ pattern
# above, just a different render (pure real-data replay, no SITL) living one level up.
field_data/**/vio_eval/postview_offline*.mp4
